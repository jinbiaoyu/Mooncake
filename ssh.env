apt-get update 
apt-get install openssh-server -y
echo "Port 2222"  >> /etc/ssh/sshd_config && echo "PermitRootLogin yes" >> /etc/ssh/sshd_config && echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
/etc/init.d/ssh  restart 
apt-get install tmux -y
apt-get install rsync -y
echo 'root:123' | chpasswd
